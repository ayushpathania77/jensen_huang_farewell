# Copy to .env.local. Never use a VITE_ prefix for secrets.
# Apply both Supabase migrations (001 tribute, then 002 messages).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Generate a random secret with at least 32 characters (e.g. 48 random bytes).
# Preserve it across restarts/deployments to retain signed visitor sessions.
SESSION_SECRET=replace-with-a-long-random-secret
TRIBUTE_STORE=supabase
# Optional custom domain for social preview image metadata.
# Vercel deployment URLs are detected automatically when omitted.
# SITE_URL=https://your-site.example

# Without a database, npm run dev:demo starts an explicitly local memory store.
# Its counts and farewell messages start empty and reset when the server stops.
# The memory store is rejected on both preview and production Vercel deployments.
# No additional secrets are required for the public message wall.
